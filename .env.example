# ==========================================
# Plantilla de variables de entorno.
# Copia este archivo como .env y pon tus valores reales.
# El archivo .env NUNCA se sube a Git.
# ==========================================

# Clave criptografica de Django. Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=pon-aqui-tu-clave-secreta

# True solo en desarrollo. SIEMPRE False en produccion.
DJANGO_DEBUG=True

# Dominios autorizados, separados por coma. Ej: miningstar.com,www.miningstar.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
